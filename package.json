{
  "name": "claude-provider-switcher",
  "displayName": "ModelHop for Claude Code",
  "description": "Run Claude Code with Anthropic, Synthetic, OpenAI API, or an experimental ChatGPT/Codex bridge, with per-role model routing and live usage.",
  "version": "2.2.4",
  "icon": "media/modelhop-icon.png",
  "license": "MIT",
  "publisher": "private",
  "repository": {
    "type": "git",
    "url": "https://github.com/markrpg/modelhop-for-claude-code.git"
  },
  "homepage": "https://github.com/markrpg/modelhop-for-claude-code#readme",
  "bugs": {
    "url": "https://github.com/markrpg/modelhop-for-claude-code/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "cursor",
    "anthropic",
    "openai",
    "chatgpt",
    "codex",
    "gpt-5.6",
    "synthetic",
    "kimi-k3",
    "provider",
    "model-routing",
    "vscode-extension",
    "ai-coding"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "compile": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile-test.json",
    "lint": "eslint src test/unit test/mobile test/fixtures/remote-mobile playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile && npm run compile:integration && node ./scripts/run-integration.mjs",
    "build:remote:fixture": "node ./scripts/build-remote-fixture.mjs",
    "remote:fixture": "npm run build:remote:fixture && node ./scripts/serve-remote-fixture.mjs",
    "test:mobile": "playwright test --config playwright.config.ts",
    "test:mobile:update": "playwright test --config playwright.config.ts --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm test && npm run compile && node ./scripts/smoke-remote-routes.mjs",
    "remote:reliability-gate": "node ./scripts/remote-reliability-gate.mjs",
    "package": "npm run remote:reliability-gate",
    "package:verify": "node ./scripts/verify-vsix.mjs",
    "package:smoke-install": "node ./scripts/smoke-install-vsix.mjs",
    "release:local": "node ./scripts/release-local.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "modelHop.select",
        "title": "ModelHop: Switch Provider"
      },
      {
        "command": "modelHop.useAnthropic",
        "title": "ModelHop: Use Anthropic"
      },
      {
        "command": "modelHop.useSynthetic",
        "title": "ModelHop: Use Synthetic"
      },
      {
        "command": "modelHop.useOpenAIApi",
        "title": "ModelHop: Use OpenAI API"
      },
      {
        "command": "modelHop.useOpenAICodex",
        "title": "ModelHop: Use OpenAI via ChatGPT/Codex (Experimental)"
      },
      {
        "command": "modelHop.configureSyntheticModels",
        "title": "ModelHop: Configure Synthetic Models"
      },
      {
        "command": "modelHop.configureOpenAIApiModels",
        "title": "ModelHop: Configure OpenAI API Models"
      },
      {
        "command": "modelHop.configureOpenAICodexModels",
        "title": "ModelHop: Configure ChatGPT/Codex Models (Experimental)"
      },
      {
        "command": "modelHop.setSyntheticToken",
        "title": "ModelHop: Set Synthetic Token"
      },
      {
        "command": "modelHop.clearSyntheticToken",
        "title": "ModelHop: Clear Synthetic Token"
      },
      {
        "command": "modelHop.setOpenAIKey",
        "title": "ModelHop: Set OpenAI API Key"
      },
      {
        "command": "modelHop.clearOpenAIKey",
        "title": "ModelHop: Clear OpenAI API Key"
      },
      {
        "command": "modelHop.logoutOpenAICodex",
        "title": "ModelHop: Sign Out of ChatGPT/Codex (Experimental)"
      },
      {
        "command": "modelHop.showUsage",
        "title": "ModelHop: Show Active Provider Usage"
      },
      {
        "command": "modelHop.openSyntheticUsage",
        "title": "ModelHop: Open Synthetic Usage and Billing"
      },
      {
        "command": "modelHop.validate",
        "title": "ModelHop: Validate Configuration"
      },
      {
        "command": "modelHop.showEffectiveConfiguration",
        "title": "ModelHop: Show Effective Configuration"
      },
      {
        "command": "modelHop.restore",
        "title": "ModelHop: Restore Previous Configuration"
      },
      {
        "command": "modelHop.repairConversations",
        "title": "ModelHop: Repair Current Conversations"
      },
      {
        "command": "modelHop.openSettings",
        "title": "ModelHop: Open Settings"
      },
      {
        "command": "modelHop.continueOnPhone",
        "title": "ModelHop: Continue on Phone"
      },
      {
        "command": "modelHop.returnToLaptop",
        "title": "ModelHop: Return to Laptop"
      },
      {
        "command": "modelHop.stopRemoteAccess",
        "title": "ModelHop: Stop Remote Access"
      },
      {
        "command": "modelHop.managePairedDevices",
        "title": "ModelHop: Manage Paired Devices"
      },
      {
        "command": "modelHop.recoverRemoteConversation",
        "title": "ModelHop: Recover Last Remote Conversation"
      },
      {
        "command": "modelHop.createRemoteSupportBundle",
        "title": "ModelHop: Create Privacy-Safe Remote Support Bundle"
      }
    ],
    "configuration": {
      "title": "ModelHop for Claude Code",
      "properties": {
        "modelHop.confirmBeforeReload": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before changing provider and reloading the Cursor or VS Code window."
        },
        "modelHop.preserveSharedPreferences": {
          "type": "boolean",
          "default": true,
          "description": "Preserve shared Claude Code traffic and attribution preferences while switching."
        },
        "modelHop.repairConversationHistory": {
          "type": "boolean",
          "default": true,
          "description": "Silently normalize incompatible tool metadata and unsigned thinking blocks before provider transitions."
        },
        "modelHop.contextManagement.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compact completed conversation history before a bridged provider reaches its context limit."
        },
        "modelHop.contextManagement.thresholdPercent": {
          "type": "number",
          "default": 72,
          "minimum": 50,
          "maximum": 90,
          "description": "Percentage of the selected model's context window at which ModelHop begins automatic compaction."
        },
        "modelHop.contextManagement.fallbackContextTokens": {
          "type": "number",
          "default": 128000,
          "minimum": 32768,
          "maximum": 2000000,
          "description": "Conservative context-window fallback when a provider does not report the selected model's capacity."
        },
        "modelHop.contextManagement.retainRecentTokens": {
          "type": "number",
          "default": 32000,
          "minimum": 8192,
          "maximum": 262144,
          "description": "Approximate amount of recent conversation history ModelHop tries to retain verbatim after compaction."
        },
        "modelHop.remote.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Experimental encrypted phone continuation through an account-free Cloudflare Quick Tunnel."
        },
        "modelHop.remote.idleTimeout": {
          "type": "string",
          "enum": [
            "15m",
            "30m",
            "60m",
            "8h",
            "manual"
          ],
          "enumItemLabels": [
            "15 minutes",
            "30 minutes",
            "1 hour",
            "8 hours",
            "Until manually stopped"
          ],
          "enumDescriptions": [
            "Return the completed conversation after 15 minutes without phone activity.",
            "Return the completed conversation after 30 minutes without phone activity.",
            "Return the completed conversation after 60 minutes without phone activity.",
            "Keep the completed conversation available until the eight-hour safety limit.",
            "Keep the completed conversation available until you return it manually or the eight-hour safety limit is reached."
          ],
          "default": "60m",
          "description": "How long a completed remote conversation remains available without phone activity. Active turns are always allowed to finish."
        },
        "modelHop.remote.inactivityMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 480,
          "deprecationMessage": "Use modelHop.remote.idleTimeout. Existing explicit values of 15, 30, 60, or 480 minutes are migrated at runtime; other values safely use 60 minutes.",
          "description": "Deprecated completed-session inactivity timeout retained for compatibility."
        },
        "modelHop.remote.maxSessionHours": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 24,
          "deprecationMessage": "ModelHop Remote now uses a fixed eight-hour safety limit. This legacy value is retained for compatibility but is ignored.",
          "description": "Deprecated maximum session duration retained for compatibility."
        },
        "modelHop.remote.cloudflaredPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to a user-managed cloudflared executable. When empty, ModelHop downloads and verifies its pinned runtime after confirmation."
        },
        "modelHop.synthetic.baseUrl": {
          "type": "string",
          "default": "https://api.synthetic.new/anthropic",
          "description": "Synthetic Anthropic-compatible endpoint."
        },
        "modelHop.synthetic.defaultModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "description": "Synthetic model used as Claude Code's default."
        },
        "modelHop.synthetic.opusModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "description": "Synthetic model used for Opus requests."
        },
        "modelHop.synthetic.sonnetModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "description": "Synthetic model used for Sonnet requests."
        },
        "modelHop.synthetic.haikuModel": {
          "type": "string",
          "default": "hf:zai-org/GLM-4.7-Flash",
          "description": "Synthetic model used for Haiku requests."
        },
        "modelHop.synthetic.subagentModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "description": "Synthetic model used for Claude Code subagents."
        },
        "modelHop.synthetic.usageRefreshMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1440,
          "description": "Minutes between uncached Synthetic quota refreshes. Set to 0 for manual refresh."
        },
        "modelHop.openaiApi.defaultModel": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "OpenAI API model used as Claude Code's default."
        },
        "modelHop.openaiApi.opusModel": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "OpenAI API model used for Opus requests."
        },
        "modelHop.openaiApi.sonnetModel": {
          "type": "string",
          "default": "gpt-5.6-terra",
          "description": "OpenAI API model used for Sonnet requests."
        },
        "modelHop.openaiApi.haikuModel": {
          "type": "string",
          "default": "gpt-5.6-luna",
          "description": "OpenAI API model used for Haiku requests."
        },
        "modelHop.openaiApi.subagentModel": {
          "type": "string",
          "default": "gpt-5.6-terra",
          "description": "OpenAI API model used for Claude Code subagents."
        },
        "modelHop.openaiApi.defaultReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high"
        },
        "modelHop.openaiApi.opusReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high"
        },
        "modelHop.openaiApi.sonnetReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium"
        },
        "modelHop.openaiApi.haikuReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "low"
        },
        "modelHop.openaiApi.subagentReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium"
        },
        "modelHop.openaiCodex.defaultModel": {
          "type": "string",
          "default": "gpt-5.6-sol"
        },
        "modelHop.openaiCodex.opusModel": {
          "type": "string",
          "default": "gpt-5.6-sol"
        },
        "modelHop.openaiCodex.sonnetModel": {
          "type": "string",
          "default": "gpt-5.6-terra"
        },
        "modelHop.openaiCodex.haikuModel": {
          "type": "string",
          "default": "gpt-5.6-luna"
        },
        "modelHop.openaiCodex.subagentModel": {
          "type": "string",
          "default": "gpt-5.6-terra"
        },
        "modelHop.openaiCodex.defaultReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high"
        },
        "modelHop.openaiCodex.opusReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high"
        },
        "modelHop.openaiCodex.sonnetReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium"
        },
        "modelHop.openaiCodex.haikuReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "low"
        },
        "modelHop.openaiCodex.subagentReasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium"
        },
        "claudeProvider.confirmBeforeReload": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use modelHop.confirmBeforeReload. This legacy setting remains supported."
        },
        "claudeProvider.preserveSharedPreferences": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use modelHop.preserveSharedPreferences."
        },
        "claudeProvider.repairConversationHistory": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use modelHop.repairConversationHistory."
        },
        "claudeProvider.synthetic.baseUrl": {
          "type": "string",
          "default": "https://api.synthetic.new/anthropic",
          "deprecationMessage": "Use modelHop.synthetic.baseUrl."
        },
        "claudeProvider.synthetic.defaultModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "deprecationMessage": "Use modelHop.synthetic.defaultModel."
        },
        "claudeProvider.synthetic.opusModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "deprecationMessage": "Use modelHop.synthetic.opusModel."
        },
        "claudeProvider.synthetic.sonnetModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "deprecationMessage": "Use modelHop.synthetic.sonnetModel."
        },
        "claudeProvider.synthetic.haikuModel": {
          "type": "string",
          "default": "hf:zai-org/GLM-4.7-Flash",
          "deprecationMessage": "Use modelHop.synthetic.haikuModel."
        },
        "claudeProvider.synthetic.subagentModel": {
          "type": "string",
          "default": "hf:moonshotai/Kimi-K3",
          "deprecationMessage": "Use modelHop.synthetic.subagentModel."
        },
        "claudeProvider.synthetic.usageRefreshMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1440,
          "deprecationMessage": "Use modelHop.synthetic.usageRefreshMinutes."
        }
      }
    }
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "tar": "^7.4.3",
    "three": "0.134.0",
    "vanta": "0.5.24"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.134.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "mocha": "^11.0.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
